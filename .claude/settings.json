{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "PowerShell(python -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(RUN_BROWSER_TESTS=1 .venv/Scripts/python.exe -m pytest *)",
      "PowerShell(.venv\\Scripts\\python.exe -m pytest *)",
      "PowerShell(Select-Object *)",
      "Bash(node --check *)",
      "PowerShell(Select-String *)",
      "Bash(curl -s -m 5 http://127.0.0.1:1234/api/v1/models)",
      "PowerShell(.venv/Scripts/python.exe -m pytest *)",
      "PowerShell($env:RUN_BROWSER_TESTS = \"1\"; .venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(./.venv/Scripts/python.exe -m pytest *)",
      "PowerShell(.\\.venv\\Scripts\\python.exe -m pytest *)",
      "PowerShell(python -m mypy *)",
      "PowerShell(git diff *)",
      "PowerShell(.\\.venv\\Scripts\\mypy.exe *)",
      "PowerShell(.venv/Scripts/mypy.exe *)",
      "Bash(.venv/Scripts/mypy.exe *)",
      "PowerShell(.\\.venv\\Scripts\\ruff.exe check *)",
      "PowerShell(.venv/Scripts/ruff.exe check *)",
      "Bash(.venv/Scripts/ruff.exe check *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git show *)",
      "PowerShell(git log *)",
      "PowerShell(python -m ruff check src)",
      "PowerShell(.venv/Scripts/python.exe -m ruff check src)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Get-ChildItem src/*)",
      "PowerShell(Get-ChildItem tests/*)",
      "PowerShell(Get-ChildItem docs/*)",
      "PowerShell(Get-Content src/*)",
      "PowerShell(Get-Content tests/*)",
      "PowerShell(Get-Content docs/*)"
    ],
    "deny": [
      "Edit(approvals/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.agent-harness/hooks/guard_approvals.py\""
          }
        ]
      }
    ]
  }
}
